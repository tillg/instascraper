!.env.example

# ─── Logs & temp artifacts ──────────────────────────────────────────────────
tmp/
*.log

# ─── Python bytecode / caches ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json

# ─── Virtual environments ───────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.python-version

# ─── Packaging / build / distribution ───────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# ─── Test & coverage reports ────────────────────────────────────────────────
.coverage
.coverage.*
htmlcov/
.tox/
coverage.xml
*.cover

# ─── Editors & IDEs ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

