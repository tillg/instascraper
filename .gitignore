# ─── instascrape: scraped output & secrets ──────────────────────────────────
output/                 # default scrape target
data/                   # common --target-dir
instagram_archives/     # alt output names
*.session               # legacy session files
.instagram_sessions/
.env                    # credentials / option defaults (also kept in ~/.config)
*.env
!.env.example           # but do track a template, if present

# ─── Logs & temp artifacts ──────────────────────────────────────────────────
tmp/
*.log

# ─── Python bytecode / caches ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json

# ─── Virtual environments ───────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.python-version

# ─── Packaging / build / distribution ───────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# ─── Test & coverage reports ────────────────────────────────────────────────
.coverage
.coverage.*
htmlcov/
.tox/
coverage.xml
*.cover

# ─── Editors & IDEs ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.\#*
\#*\#

# ─── macOS / OS cruft ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
